# macOS
.DS_Store
._*

# xcodegen 生成物：工程文件是产物不是源码，改 project.yml 而不是改 pbxproj
# 按通配写而不是写死 Crab.xcodeproj/：改工程名时旧名字的生成物会留在磁盘上成为孤儿，
# git status 又看不见它（AILab.xcodeproj/ 就是这么露出来的，见 docs/工程事实.md 第 10 节）。
*.xcodeproj/

# Xcode
build/
DerivedData/
*.xcuserstate
*.moved-aside
xcuserdata/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# 验收脚本的中间产物
.probe/

# 密钥与本地配置
.env
.env.*
*.p8
*.p12
*.mobileprovision
Secrets.swift
Secrets.xcconfig

# 编辑器与工具
.idea/
*.swp
.claude/settings.local.json
